# Google Gemini API Key (Get from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Instagram Graph API Access Token (Long-lived or System User Token)
# Permissions required: instagram_basic, instagram_content_publish
IG_ACCESS_TOKEN=your_instagram_graph_api_access_token_here

# Instagram Business Account ID (Found via Graph API or Meta Business Suite)
IG_USER_ID=your_instagram_business_account_id_here
